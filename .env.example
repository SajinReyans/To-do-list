# ==========================================
# Frontend Environment Variables (Vite)
# ==========================================
# Supabase project URL and Public Anon Key (safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# Backend Environment Variables (Node.js/Express)
# ==========================================
PORT=4000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & CORS Settings
# Allowed origins comma-separated (e.g. https://yourdomain.com,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (Optional - requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
