# ==========================================
# Frontend Environment Variables (Vite)
# ==========================================
# Supabase project URL and Public Anon Key (safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (leave empty for same-origin /api in unified deployment, or set to https://aloft-backend.onrender.com)
VITE_API_URL=

# ==========================================
# Backend Environment Variables (Node.js/Express)
# ==========================================
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Configuration (SERVICE_ROLE_KEY is strictly for backend, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & CORS Settings
# Allowed origins comma-separated (e.g. https://aloft-frontend.onrender.com,http://localhost:5173)
# Note: Render domains (*.onrender.com) are automatically allowed by default
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (Optional - requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
