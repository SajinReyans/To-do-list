PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Credentials (keep service-role key strictly on the backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & CORS Settings
# Comma-separated allowed origins (e.g. https://aloft-frontend.onrender.com,http://localhost:5173)
# Note: Render domains (*.onrender.com) are automatically allowed by default
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
