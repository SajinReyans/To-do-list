{
  "name": "aloft-todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "render-build": "npm install --include=dev && npm run build",
    "install:all": "npm install --include=dev && npm install --include=dev --prefix frontend && npm install --prefix backend",
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start": "npm run start --prefix backend",
    "test": "npm run test --prefix backend",
    "lint": "npm run lint --prefix frontend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
